# 🔐 SHMRY Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to source control

# =============================================================================
# ADMIN CREDENTIALS (Store in secure vault - 1Password, Vault, SSM)
# =============================================================================
ADMIN_ID=your_admin_id_here
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SESSION_SECRET=your_session_secret_here

# =============================================================================
# DATABASE & STORAGE
# =============================================================================
DATABASE_URL=your_database_connection_string
STORAGE_PATH=/path/to/secure/storage
BACKUP_PATH=/path/to/backup/storage

# =============================================================================
# API KEYS & EXTERNAL SERVICES
# =============================================================================
VERCEL_TOKEN=your_vercel_token_here
AI_MODEL_API_KEY=your_ai_model_api_key_here
WHATSAPP_API_KEY=your_whatsapp_api_key_here

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
CORS_ORIGIN=https://www.shmry.com

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=80
ADMIN_PORT=3001
MASTER_PORT=3002
NETWORK_PORT=3003

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=info
MONITORING_ENABLED=true
AUDIT_LOGGING_ENABLED=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MS=600000

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
AI_MODEL_DOWNLOAD_ENABLED=false
AI_MODEL_STORAGE_QUOTA_GB=100
AI_MODEL_WORKER_NODE_URL=https://worker.shmry.com

# =============================================================================
# SECURITY HEADERS
# =============================================================================
HSTS_MAX_AGE=31536000
CSP_ENABLED=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
